{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rlinf.readthedocs.io/schemas/libero_safety_episode_audit_v1.schema.json",
  "title": "LIBERO-Safety episode audit v1",
  "type": "object",
  "required": [
    "schema_version",
    "timestep_base",
    "episode",
    "trajectory",
    "outcome",
    "success",
    "unsafe",
    "quadrant",
    "trajectory_after_violation"
  ],
  "properties": {
    "schema_version": {
      "const": "libero_safety_episode_audit/v1"
    },
    "timestep_base": {
      "const": 1
    },
    "episode": {
      "type": "object",
      "required": [
        "episode_id",
        "process_id",
        "env_index",
        "episode_index",
        "collection_mode",
        "task_suite",
        "safety_level",
        "task_id",
        "trial_id",
        "reset_state_id",
        "instruction"
      ],
      "properties": {
        "collection_mode": {
          "enum": ["official_eval", "shadow_collect"]
        }
      }
    },
    "initial_observation": {},
    "visual_trajectory": {
      "type": "object",
      "required": [
        "format",
        "path",
        "camera_keys",
        "num_frames",
        "preprocessing",
        "alignment"
      ],
      "properties": {
        "format": {"const": "npz"},
        "path": {"type": "string"},
        "camera_keys": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "num_frames": {"type": "integer", "minimum": 2},
        "preprocessing": {
          "const": "rotate_180_to_rlinf_policy_view"
        },
        "alignment": {
          "const": "frame[t] + action[t] -> frame[t+1]"
        }
      },
      "additionalProperties": false
    },
    "success": {"type": "boolean"},
    "unsafe": {"type": "boolean"},
    "quadrant": {"enum": ["Q1", "Q2", "Q3", "Q4"]},
    "root_episode_id": {"type": "string"},
    "branch_id": {"type": "string"},
    "alpha": {"type": "number", "minimum": 0, "maximum": 1},
    "perturbation_range": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "trajectory_after_violation": {
      "type": "array",
      "items": {"$ref": "#/$defs/transition"}
    },
    "trajectory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "raw_task_success",
        "safety_violation",
        "success",
        "unsafe",
        "severe_collision",
        "safe_task_success",
        "quadrant",
        "first_raw_task_success_timestep",
        "first_violation_timestep",
        "first_severe_collision_timestep",
        "end_reason",
        "num_transitions"
      ],
      "properties": {
        "success": {"type": "boolean"},
        "unsafe": {"type": "boolean"},
        "raw_task_success": {"type": "boolean"},
        "safety_violation": {"type": "boolean"},
        "severe_collision": {"type": "boolean"},
        "safe_task_success": {"type": "boolean"},
        "quadrant": {"enum": ["Q1", "Q2", "Q3", "Q4"]},
        "first_raw_task_success_timestep": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "first_violation_timestep": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "first_severe_collision_timestep": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "end_reason": {
          "enum": [
            "raw_task_success",
            "safety_violation",
            "severe_collision",
            "horizon",
            "external_reset",
            "environment_close"
          ]
        },
        "num_transitions": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "required": [
        "instance_id",
        "source",
        "predicate",
        "arguments",
        "semantics",
        "value"
      ],
      "properties": {
        "instance_id": {"type": "string"},
        "source": {"enum": ["goal", "constraint"]},
        "predicate": {"type": "string"},
        "arguments": {"type": "array"},
        "semantics": {"enum": ["satisfaction", "violation"]},
        "value": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "timestep",
        "action",
        "reward",
        "terminations",
        "predicates"
      ],
      "properties": {
        "timestep": {"type": "integer", "minimum": 1},
        "action": {},
        "reward": {},
        "observation": {},
        "terminations": {
          "type": "object",
          "required": [
            "raw_task",
            "safety_violation",
            "severe_collision",
            "official",
            "emitted",
            "truncated"
          ],
          "properties": {
            "raw_task": {"type": "boolean"},
            "safety_violation": {"type": "boolean"},
            "severe_collision": {"type": "boolean"},
            "official": {"type": "boolean"},
            "emitted": {"type": "boolean"},
            "truncated": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "predicates": {
          "type": "array",
          "items": {"$ref": "#/$defs/predicate"}
        }
      },
      "additionalProperties": false
    }
  }
}
